POSTGRES_NAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_APP_NAME=totem-backend

# Name of the application in Postgres (pg_stat_activity, logs): set per
# container in docker-compose.yml.
# POSTGRES_APP_NAME=totem-backend
# Connection pool of each database (see `totem/settings.py` for the defaults).
# DB_POOL_MAX_SIZE=4
# DB_POOL_EVICT_AFTER=600
# Beat: longest sleep between two looks at the schedules, and between two
# reads of the list of tenants (seconds).
# CELERY_BEAT_MAX_LOOP_INTERVAL=300
# BEAT_TENANT_REFRESH=300

CELERY_BROKER_URL=redis://redis:6379/0

TOTEM_DEBUG=True
TOTEM_SECRET_KEY=7c4ven15&9#aa5ntiq(v7h4u!9+si8pl^ga1x+9nus
TOTEM_CSRF_TRUSTED_ORIGINS=http://*.localhost:8000/,http://*.localhost:3006/,http://*.localhost:9999

# Catalog of the tenants, shared with the multi-tenant proxy. Unset: no catalog.
# SAAS_DB_NAME=saas_base
# Key of the operator API creating tenant databases (`X-Api-Key`). Unset: no API.
SAAS_API_KEY=dev-saas-api-key
